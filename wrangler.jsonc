{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homebrew",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "homebrew.lbenicio.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "APP_FILES",
      "bucket_name": "cdn"
    }
  ]
}
