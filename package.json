{
  "name": "lbenicio-homebrew-worker",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "coverage": "c8 --all --extension .ts --include 'src/**/*.ts' --reporter=lcov --reporter=text --reports-dir=coverage node --experimental-strip-types --test test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261116.1",
    "c8": "^12.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
